{
  "name": "@observer-ai/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "observer": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
